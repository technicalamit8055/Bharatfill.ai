# ---------------------------------------------------------------------------
# Assistigo.ai environment template
# Copy to .env.local (web app) and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Local dev (supabase start) prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Bypasses RLS. Never expose to the browser or the extension.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Direct Postgres connection, used only by RLS / integration tests.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# Comma separated extension IDs allowed to call the extension API surface and to be handed a
# pairing code by /extension/connect. Leave empty in local dev to allow any well-formed id.
# Outside local this FAILS CLOSED: an empty allowlist means no extension can pair at all.
# Find the id at chrome://extensions with developer mode on.
EXTENSION_ALLOWED_IDS=

# Baked into the extension at build time; must match an origin in the manifest's
# externally_connectable list. Defaults to http://localhost:3000 when unset.
VITE_DASHBOARD_URL=

# --- Encryption -----------------------------------------------------------
# 32-byte key, base64 encoded. Used for AES-256-GCM field encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# --- OCR / AI providers ---------------------------------------------------
# See docs/AI_PIPELINE.md §2. There are two provider slots, not one.

# The LOCAL reader: never lets a byte leave this server.
#   local     — reads embedded PDF text and text uploads (the default; use this)
#   mock      — reads the demo fixtures. For tests, CI and the demo seed only.
#   tesseract — declared in the spec, not implemented
OCR_PROVIDER=local

# The AI VISION reader: sends the document to a third party, so it is off by default.
#   none      — no AI reading on this deployment (default; fails closed)
#   deepseek  — OpenAI-compatible chat endpoint
#   anthropic — declared in the spec, not implemented
# Turning this on is not enough by itself: each organization must also set
# settings.ai_processing_enabled, which an owner switches on after reading the AI notice.
OCR_AI_PROVIDER=none

# Required when OCR_AI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=

# Optional overrides. The AI reader speaks the OpenAI chat-completions shape, so these repoint it
# at any compatible endpoint — another vendor, a gateway, or a self-hosted vision model — without
# a code change. NOTE: the model you point at must accept image input, or only text-bearing PDFs
# will be readable.
# OCR_AI_BASE_URL=https://api.deepseek.com
# OCR_AI_MODEL=deepseek-chat

# Only used if OCR_AI_PROVIDER=anthropic, which is not implemented yet.
ANTHROPIC_API_KEY=

# --- Background jobs ------------------------------------------------------
# Shared secret for POST /api/jobs/run, which drains the job queue (OCR extraction and friends).
# That route runs with the service-role key, so it FAILS CLOSED: leave this unset and the
# endpoint refuses every request. Set it wherever a scheduler will call the route.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
JOB_RUNNER_SECRET=

# Whether POST /api/documents/:id/process runs that document's extraction job in-request rather
# than leaving it for a scheduler. `on` by default: with no scheduler pointed at /api/jobs/run,
# an uploaded document otherwise sits at "Reading" forever. It claims only the job for the
# document being processed, so one tenant's upload never runs another's work.
# Set to `off` when a scheduler owns the queue and upload requests should stay fast.
# on | off
JOB_INLINE_RUNNER=on

# --- Billing --------------------------------------------------------------
# mock | razorpay | stripe
BILLING_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Observability --------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Super Admin panel (/admin) -------------------------------------------
# Comma-separated emails treated as platform Super Admins even without a `platform_admins` row.
# This is a BOOTSTRAP so the first owner can open /admin on a fresh database and add the rest of
# the team; unset means the roster table is the only way in, which is where a mature deployment
# should end up. Matching is case-insensitive and ignores surrounding whitespace.
ADMIN_EMAILS=

# Whether the scraper's `http` fetcher may make outbound requests to a configured source URL.
# OFF by default, and deliberately a deployment switch rather than a per-source setting:
# configuring a source is a content decision an employee makes, but pointing this deployment's
# servers at a government portal is an operational and legal one. With it off, `http` sources
# stage nothing and each run records why. `manual` and `fixture` sources are unaffected.
# on | off
SCRAPER_HTTP_ENABLED=off

# Extra hostnames the `http` fetcher may contact, comma-separated (e.g. ssc.gov.in,nsp.gov.in).
# Empty means only the built-in public government domain list is allowed. A source URL outside
# both lists is refused before any request is made.
SCRAPER_ALLOWED_HOSTS=

# Whether "Continue with Google" on the sign-in screen starts an OAuth flow. OFF by default.
# Turning it on also needs the Google provider configured in Supabase Auth, and is a product
# decision: a first Google sign-in creates an account without the sign-up consent step.
# on | off
AUTH_GOOGLE_ENABLED=off

# --- Walk-in document drop (QR bot) ---------------------------------------
# The walk-in citizen sends Aadhaar / marksheet / photo straight into the operator's queue.
# Every credential below is OPTIONAL and every channel FAILS CLOSED: unset means that channel
# refuses to mint a session and its webhook returns 404. The mobile web drop (/drop/<code>)
# needs none of them, so leaving this whole block empty still gives you a working intake.
#
# These are the FALLBACK. A Super Admin can configure both channels from the browser instead, at
# /admin/channels — those settings are stored encrypted and take priority over everything below,
# so key rotation needs no redeploy. This block stays authoritative until somebody saves a row
# there, which is what keeps an existing env-configured deployment working unchanged.

# WhatsApp Cloud API (Meta). Point the webhook at POST /api/webhooks/whatsapp.
# Verify token: any high-entropy string; Meta echoes it back during the one-time handshake.
WHATSAPP_VERIFY_TOKEN=
# Permanent or system-user access token used to fetch inbound media and post acknowledgements.
WHATSAPP_ACCESS_TOKEN=
# The business phone number id (not the number itself) that replies are sent from.
WHATSAPP_PHONE_NUMBER_ID=
# The public number a citizen messages, used to build the wa.me deep link behind the QR.
WHATSAPP_BOT_NUMBER=
# App secret behind X-Hub-Signature-256. Required in staging and production: without it a
# delivery cannot be proven to have come from Meta, and intake refuses unsigned bodies.
WHATSAPP_APP_SECRET=

# Telegram Bot API. Point the webhook at POST /api/webhooks/telegram with the secret_token set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Echoed by Telegram in X-Telegram-Bot-Api-Secret-Token on every delivery.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
