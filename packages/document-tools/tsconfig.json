{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is needed because src/browser/* drives canvas and the File/Blob APIs. The pure
    // modules under src/ deliberately touch none of it, so they stay unit-testable in Node.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@assistigo/core": ["../core/src/index.ts"],
      "@assistigo/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
