  "urlPatterns": ["https://ssc.gov.in/**", "https://*.ssc.gov.in/**"],
  "version": "1.2.0",
  "status": "testing",
  "notes": "Covers OTR and the CGL/CHSL/GD forms, which re-display the OTR profile. Label-driven: SSC's Angular front end generates control names (ctrl_12). Education Details uses generic boxes (Roll Number, Passing Year, Name of Board/University) whose qualification is chosen by the 'Qualifying Educational Qualification' dropdown, so those fields declare educationLevels; the level comes from the box's label or heading, else the operator's pick in the side panel, else the customer's highest recorded level (always reviewed). Address boxes declare contextVariants: present/correspondence headings map to customer.address.*, permanent ones to customer.permanent_address.*. Names are English-only (script latin).",
  "knownIssues": "Not filled, left to the operator: Identification Marks (no registry field; a SECURITY.md §4 decision), State/UT of Board/University, Highest/Qualifying Educational Qualification and EQ Status (portal choices, not customer data), marital status (SSC's Unmarried/Married does not match the registry's options), disability and ex-servicemen questions. Full Aadhaar is never mapped, only customer.aadhaar_last4. Captcha and OTP are never touched. Category, date of birth and Aadhaar last-4 are always reviewed.",
  "documentRequirements": [
    {
      "key": "photo",
      "label": "Applicant photograph (20–50 KB JPEG, name and date stamped)",
      "presetCode": "ssc.photo",
      "required": true,
      "notes": "Captured live through the portal's webcam step at OTR, or uploaded as a 20–50 KB JPEG. SSC rejects a photograph that does not carry the applicant's name and the date of capture printed on it, and one taken more than three months earlier."
    },
    {
      "key": "signature",
      "label": "Signature (10–20 KB JPEG, 6.0 × 2.0 cm at 300 DPI)",
      "presetCode": "ssc.signature",
      "required": true,
      "notes": "Black or blue ink on plain white paper, 10–20 KB JPEG, 6.0 × 2.0 cm at 300 DPI (709 × 237 px), horizontal. SSC rejects any other size, a blurred or miniature signature, and one written in capital letters."
    }
  ],
