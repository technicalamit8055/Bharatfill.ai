# Citizen app cloud sign-in (docs/VAULT_BRIDGE_DESIGN.md §2). Copy to apps/mobile/.env for
# `expo start`; set the same three as EAS environment variables for builds.
#
# All three or none. Leave them blank and the app is offline-only: sign-in says it is not live
# yet and nothing leaves the phone. These are PUBLIC values compiled into the app — never put
# the service-role key or VAULT_MASTER_KEY here.

# Supabase project URL and its public anon key (the same project as the dashboard).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard origin serving /api/citizen/*. https only; a development build also accepts
# http to a LAN/loopback dev server, e.g. http://192.168.1.20:3000 (10.0.2.2 for the emulator).
EXPO_PUBLIC_BHARATFILL_API_URL=
