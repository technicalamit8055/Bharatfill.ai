{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "types": [
      "react",
      "expo"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@assistigo/core": [
        "../../packages/core/src/index.ts"
      ],
      "@assistigo/core/*": [
        "../../packages/core/src/*"
      ],
      "@assistigo/form-engine/requirement-checklist": [
        "../../packages/form-engine/src/requirement-checklist.ts"
      ],
      "@assistigo/document-tools": [
        "../../packages/document-tools/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "ios",
    "android",
    "dist"
  ]
}