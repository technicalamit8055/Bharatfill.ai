{
  "expo": {
    "name": "Bharatfill",
    "slug": "bharatfill-citizen",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bharatfill",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.bharatfill.citizen"
    },
    "android": {
      "package": "ai.bharatfill.citizen",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bharatfill opens your photos only when you choose one to add to your vault.",
          "cameraPermission": "Bharatfill uses the camera to scan your documents. Scans are encrypted and kept on this phone.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
