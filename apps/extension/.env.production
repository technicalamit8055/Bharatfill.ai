# Dashboard the production extension build pairs with and calls (`npm run build:extension`).
# Must match an origin in public/manifest.json `externally_connectable`, and the background
# worker compares it as an exact origin — so this is the www host the site is served from.
# Not a secret: it ends up in the shipped bundle.
VITE_DASHBOARD_URL=https://www.bharatfillai.in
